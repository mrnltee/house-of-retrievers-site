# Every variable the app reads. Real values live in Vercel (Production and
# Preview); pull them with `npx vercel env pull .env.local`. Never commit
# values, and never prefix any of these with NEXT_PUBLIC_.

# Instagram feed. The live token rotates in a private Vercel Blob; this is only the seed.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=17841440369853992
INSTAGRAM_API_VERSION=v26.0
BLOB_READ_WRITE_TOKEN=
# Vercel's signed call to /api/cron/refresh-instagram-token.
CRON_SECRET=

# Join form → Google Apps Script → Sheet (and Drive for photos).
GOOGLE_APPS_SCRIPT_URL=
JOIN_FORM_SECRET=

# Admin module. DATABASE_URL comes from the Neon integration in Vercel
# (staging and production share it). Builds run migrations against it.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Google sign-in for admins: Google Cloud console → OAuth client (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: session signing key. If unset, one is derived from DATABASE_URL.
NEXTAUTH_SECRET=
# Production: https://admin.houseofretrieversph.org
NEXTAUTH_URL=
# Comma-separated Google emails that are always Owners.
ADMIN_OWNER_EMAILS=
# Local testing only: lets `next dev` sign in by typing an invited email.
ADMIN_DEV_LOGIN=

# Email through Resend. Without RESEND_API_KEY + EMAIL_FROM, sending is skipped quietly.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Admin alert emails (app/lib/admin/notify.js).
ADMIN_ALERT_FROM=

# Event albums (Cloudinary, free plan).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: suggests photo descriptions in the event editor (Google AI Studio key, free tier).
GEMINI_API_KEY=
# Optional: a current Gemini model name, if the default is retired.
GEMINI_MODEL=
# Optional: override the Gemini API base URL (testing).
GEMINI_API_BASE=

# Optional: override the OpenStreetMap Nominatim endpoints used by the venue search.
NOMINATIM_URL=
NOMINATIM_REVERSE_URL=

# Pre-launch countdown preview key (expired 10 Oct 2026; remove with the countdown module).
COUNTDOWN_PREVIEW_KEY=
