# Local testing only: lets `next dev` sign in by typing an invited email.
ADMIN_DEV_LOGIN=
# Phase 2 (optional): alert emails through Resend.
RESEND_API_KEY=
ADMIN_ALERT_FROM=

# Optional: suggests photo descriptions in the event editor (Google AI Studio key, free tier).
